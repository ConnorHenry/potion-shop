Entries = [
{"id":"mooncap_mushroom","name":"Mooncap Mushroom","iconPath":"res://Assets/Items/mandrake_root.svg","description":"A rare mushroom that only grows in the light of a full moon. Said to have mild sedative properties and a faintly luminescent quality.","quality":85,"price":14,"traits":{"calm":5},"risks":{},"tags":["ingredient"]},
{"id":"grave_mint","name":"Grave Mint","iconPath":"res://Assets/Items/henbane_leaf.svg","description":"A hardy mint that grows in graveyards and other places touched by death. It has a refreshing aroma and a bitter, earthy flavor.","quality":70,"price":7,"traits":{"soothe":4},"risks":{},"tags":["ingredient"]},
{"id":"black_ichor","name":"Black Ichor","iconPath":"res://Assets/Items/black_candle.svg","description":"A viscous, tar-like substance that seeps from the wounds of certain cursed creatures. It is highly toxic and has a corrupting influence on those who handle it.","quality":95,"price":19,"traits":{"rest":5},"risks":{},"tags":["ingredient"]},
{"id":"lavender_ash","name":"Lavender Ash","iconPath":"res://Assets/Items/bone_charm.svg","description":"A fine ash made from burned lavender flowers. It has a soothing scent and is often used in calming rituals and sleep aids.","quality":80,"price":10,"traits":{"dream":5},"risks":{},"tags":["ingredient"]},
{"id":"obsidian_resin","name":"Obsidian Resin","iconPath":"res://Assets/Items/myrrh_resin.svg","description":"A glossy, pitch-dark resin that hardens in moonless air. Brewers prize it for binding volatile mixtures into stable tinctures.","quality":88,"price":16,"traits":{"mend":5},"risks":{},"tags":["ingredient"]},
{"id":"amber_nightshade","name":"Amber Nightshade","iconPath":"res://Assets/Items/amber_nightshade.svg","description":"A poisonous nightshade blossom sealed in honey-colored sap. Its warm scent lingers in the mind and draws out vivid nocturnal reveries.","quality":84,"price":12,"traits":{"vigor":5},"risks":{},"tags":["ingredient"]},
{"id":"silver_thorn_bloom","name":"Silver Thorn Bloom","iconPath":"res://Assets/Items/silver_thorn_bloom.svg","description":"A pale flower with needle-fine petals that glint like silver in dusk light. Distillers value it for sharp clarity and wakeful focus.","quality":82,"price":9,"traits":{"clarity": 5},"risks":{},"tags":["ingredient"]},
{"id":"moonwhisper_orchid","name":"Moonwhisper Orchid","iconPath":"res://Assets/Items/moonwhisper_orchid.svg","description":"A dusk-bloom orchid whose petals shimmer pale blue under moonlight. Its fragrance soothes the mind while coaxing vivid dreams.","quality":86,"price":18,"traits":{"charm": 5},"risks":{},"tags":["ingredient"]},
{"id":"raven_ash_peony","name":"Raven Ash Peony","iconPath":"res://Assets/Items/raven_ash_peony.svg","description":"A smoke-dark peony harvested from old funeral grounds. When crushed, it releases a soft gray ash that steadies trembling hands.","quality":79,"price":6,"traits":{"courage": 5},"risks":{},"tags":["ingredient"]},
{"id":"iron_lullaby_root","name":"Iron Lullaby Root","iconPath":"res://Assets/Items/iron_lullaby_root.svg","description":"A knotted root with a hard metallic skin and a strangely comforting scent. Brewers grate it into tonics meant to quiet panic and blunt pain.","quality":83,"price":11,"traits":{"cleanse": 5},"risks":{},"tags":["ingredient"]},
]

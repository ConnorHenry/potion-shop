[ext_resource type="Script" path="res://Scripts/Models/AuthoredEventsResource.cs" id="1"]

[resource]
script = ExtResource("1")
Entries = [{"id":"knocking_at_back_door","title":"Knocking at the Back Door","text":"Three knocks. No one outside. The air smells like pennies.","requires":{"dreadMin":0},"weight":10,"choices":[{"label":"Open it","effects":[{"addGold":30},{"addDread":8},{"addRule":"no_mirrors"}]},{"label":"Ward it with salt","requires":{"hasItemId":"salt","hasItemQty":1},"effects":[{"consumeItemId":"salt","consumeItemQty":1},{"addDread":2}]}]},{"id":"the_customer_with_no_face","title":"The Customer With No Face","text":"A hooded figure slides a note across the counter: 'Something that helps me forget.'","requires":{"dreadMin":8},"weight":8,"choices":[{"label":"Sell a Bone Charm","requires":{"hasItemId":"bone_charm","hasItemQty":1},"effects":[{"consumeItemId":"bone_charm","consumeItemQty":1},{"addGold":80},{"addDread":6}]},{"label":"Refuse","effects":[{"addDread":4},{"addRule":"thin_veil"}]}]},{"id":"bone_charm_hawker","title":"Bone Charm Hawker","text":"A gaunt peddler arrives at dusk and unwraps a bone charm from a stained cloth. '100 gold,' they say. 'You will want this before the week is out.'","characterImagePath":"res://Assets/Characters/bone_charm_hawker.svg","requires":{"dreadMin":0},"weight":6,"choices":[{"label":"Accept","requires":{"goldMin":100},"effects":[{"addGold":-100},{"addItemId":"bone_charm","addItemQty":1}]},{"label":"Refuse","effects":[{"addDread":20}]}]}]

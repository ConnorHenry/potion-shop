Entries = [
  {
    "id": "customer_requests_sleep_draught",
    "title": "Sleep Draught",
    "text": "A tired customer rubs their eyes and says they have not slept properly in days. They need something to help their body settle and their mind drift away.",
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "early",
    "difficulty": 1,
    "requires": {
      "dayMin": 1,
      "dayMax": 4
    },
    "weight": 10,
    "desiredTraits": {
      "rest": { "min": 5 },
      "calm": { "min": 3 },
      "dream": { "min": 2 }
    },
    "badTraits": {}
  },
  {

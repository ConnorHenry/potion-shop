  {
    "id": "customer_requests_obsidian_stitch_draught",
    "title": "Obsidian Stitch Draught",
    "text": "A surgeon sets a cracked silver needle on the counter. They need a draught with mend above 8, but vigor below 2 so the patient does not tear the stitching open.",
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "late",
    "difficulty": 4,
    "requires": {
      "dayMin": 6
    },
    "weight": 8,
    "desiredTraits": {
      "mend": { "min": 9 },
      "courage": { "min": 3 }
    },
    "badTraits": {},
    "requiredMinTraits": {
      "mend": 9
    },
    "requiredMaxTraits": {
      "vigor": 1
    },
    "potionResponses": [
      {
        "id": "threshold_success",
        "success": true,
        "text": "The surgeon turns the bottle slowly. 'Strong enough to close the wound, quiet enough to keep them still. This will do.'"
      },
      {
        "id": "threshold_failure",
        "success": false,
        "text": "The surgeon frowns at the mixture. 'No. Too weak for stitching, or too lively for a patient who must stay still.'"
      }
    ]
  },
  {
    "id": "customer_requests_chapel_ward_ink",
    "title": "Chapel Clarity Ink",
    "text": "A chapel warden asks for ink to mark the cellar lintel. They need clarity at 4 or higher, with dream no higher than 1; anything dreamlike invites the thing to answer.",
    "characterImagePath": "res://Assets/Characters/chapel_warden.svg",
    "pool": "late",
    "difficulty": 4,
    "requires": {
      "dayMin": 6

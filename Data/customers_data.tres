    "badTraits": {},
    "requiredMinTraits": {
      "reflexes": 4
    },
    "requiredMaxTraits": {
      "rest": 1
    },
    "potionResponses": [
      {
        "id": "threshold_success",
        "success": true,
        "text": "The cutter flexes their fingers. 'Fast, but not sleepy. I can work with this.'"
      },
      {
        "id": "threshold_failure",
        "success": false,
        "text": "The cutter shakes their head. 'My hands need speed, not a lullaby.'"
      }
    ]
  },
  {
    "id": "customer_requests_mercy_tincture",
    "title": "Mercy Tincture",
    "text": "A hospice sister asks for something gentle but useful. They need empathy at 4 or higher, and vigor no higher than 1; comfort must not become agitation.",
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "late",
    "difficulty": 4,
    "requires": {
      "dayMin": 6
    },
    "weight": 8,
    "desiredTraits": {
      "empathy": 4,
      "mend": 6
    },
    "badTraits": {},
    "requiredMinTraits": {
      "empathy": 4
    },
    "requiredMaxTraits": {
      "vigor": 1
    },
    "potionResponses": [
      {
        "id": "threshold_success",
        "success": true,
        "text": "The sister softens. 'Kind, mending, and not forceful. This is mercy, not shock.'"
      },
      {
        "id": "threshold_failure",
        "success": false,
        "text": "The sister pushes the bottle back. 'It does not comfort enough, or it pushes too hard.'"
      }
    ]
  },
  {
    "id": "customer_requests_muse_cordial",
    "title": "Muse Cordial",
    "text": "A blocked illuminator needs the first line of a manuscript to open in their mind. They need creativity at 4 or higher, but clarity no higher than 1 so judgment does not smother the image.",
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "late",
    "difficulty": 4,
    "requires": {

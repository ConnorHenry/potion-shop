      "creativity": 4
    },
    "requiredMaxTraits": {
      "clarity": 1
    },
    "potionResponses": [
      {
        "id": "threshold_success",
        "success": true,
        "text": "The illuminator smiles at a blank page only they can see. 'Loose enough to imagine, calm enough to begin.'"
      },
      {
        "id": "threshold_failure",
        "success": false,

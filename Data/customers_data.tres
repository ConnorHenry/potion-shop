    },
    "potionResponses": [
      {
        "id": "threshold_success",
        "success": true,
        "text": "The warden taps the cork twice. 'Clear, plain, and without a dreaming edge. Good.'"
      },
      {
        "id": "threshold_failure",
        "success": false,
        "text": "The warden steps back. 'That mark would not hold clearly, or it would dream too loudly in the dark.'"
      }
    ]
  },
  {
    "id": "customer_requests_glass_truth_tonic",
    "title": "Glass Clarity Tonic",
    "text": "A solicitor wants a tonic for a witness. They need clarity at 4 or higher, but charm no higher than 1; persuasion would spoil the testimony.",

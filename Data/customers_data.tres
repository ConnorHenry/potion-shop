[resource]
script = ExtResource("1")
Entries = [
  {
    "id": "customer_requests_sleep_draught",
    "title": "Sleep Draught",
    "text": "A tired customer rubs their eyes and says they have not slept properly in days. They need something to help their body settle and their mind drift away.",
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "early",
    "difficulty": 1,
    "requires": {
      "dayMin": 1,
      "dayMax": 4
    },
    "weight": 10,
    "desiredTraits": {
      "rest": 5,
      "calm": 3,
      "dream": 2
    },
    "badTraits": {}
  },
  {
    "id": "customer_requests_nightmare_ward",
    "title": "Nightmare Ward",
    "text": "A nervous customer says the same nightmare waits for them every night. They are afraid to close their eyes and need something to help them face their dreams.",

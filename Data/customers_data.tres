      "dayMax": 8
    },
    "weight": 10,
    "desiredTraits": {
      "dream": 5,
      "calm": 3,
      "courage": 2
    },
    "badTraits": {}
  },
  {
    "id": "customer_requests_pain_relief_tonic",
    "title": "Pain Relief Tonic",

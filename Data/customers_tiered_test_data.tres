[gd_resource type="Resource" script_class="AuthoredCustomerInteractionsResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Models/AuthoredCustomerInteractionsResource.cs" id="1"]

[resource]
script = ExtResource("1")
Entries = [
  {
    "id": "plot_bridget_visit_1",
    "title": "Bridget",
    "text": "Bridget welcomes you to the village and recognizes that you carry The Knowledge.",
    "lines": [
      {
        "text": "An old woman waits near the door, shawl pinned tight against the damp air.",
        "characterImageKey": "happy"
      },
      {
        "speaker": "Bridget",
        "text": "'You're the new one, then. Welcome to the village, my dear.'",
        "characterImageKey": "happy"
      }
    ],
    "characterImagePath": "res://Assets/Characters/old_rural_woman_sprite_happy.png",
    "characterImagePaths": {
      "happy": "res://Assets/Characters/old_rural_woman_sprite_happy.png",
      "sad": "res://Assets/Characters/old_rural_woman_sprite_sad.png"
    },
    "pool": "plot",
    "difficulty": 1,
    "storyCharacterId": "bridget",
    "visitId": "visit_1",
    "dialogueStartNodeId": "intro",
    "requires": {
      "dayMin": 1
    },
    "weight": 2,
    "desiredTraits": {},
    "badTraits": {},
    "dialogueNodes": [
      {
        "id": "intro",
        "lines": [
          {
            "text": "She smiles as though she has known your family name longer than you have.",
            "characterImageKey": "happy"
          },
          {
            "speaker": "Bridget",
            "text": "'Bridget, that's me. If you need bread, gossip, or the name of a good thatcher, you come and find me.'",
            "characterImageKey": "happy"
          },
          {
            "text": "Her smile softens, and her eyes settle on your hands.",
            "characterImageKey": "sad"
          },
          {
            "speaker": "Bridget",
            "text": "'And I know you have {i|The Knowledge}. In Ireland, that's what some call knowing the old properties of things: brewing, healing, and the uses hidden in leaf and root.'",
            "characterImageKey": "sad"
          }
        ],
        "options": [
          {
            "id": "intro_ask_knowledge",
            "label": "How did you know?",
            "responseLines": [
              {
                "text": "Bridget gives a small, knowing shrug.",
                "characterImageKey": "happy"
              },
              {
                "speaker": "Bridget",
                "text": "'You look at herbs the way a mason looks at stone. A body learns to notice.'",
                "characterImageKey": "happy"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_ask_village",
            "label": "Tell me about the village.",
            "responseLines": [
              {
                "text": "She glances back toward the rain-slick lane.",
                "characterImageKey": "happy"
              },
              {
                "speaker": "Bridget",
                "text": "'Small enough to hear every kettle boil, large enough to keep secrets badly. You'll do fine if you listen before you answer.'",
                "characterImageKey": "happy"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_accept",
            "label": "Thank you, Bridget.",
            "responseLines": [
              {
                "text": "Bridget pats your arm once, gentle but firm.",
                "characterImageKey": "happy"
              },
              {
                "speaker": "Bridget",
                "text": "'There's a welcome here for you. Mind you use that Knowledge kindly.'",
                "characterImageKey": "happy"
              }
            ],
            "endsInteraction": true,
            "effects": [
              {
                "addStoryFlag": "bridget_welcomed_player"
              }
            ]
          }
        ]
      },
      {
        "id": "hub",
        "lines": [
          {
            "text": "Bridget waits, patient as a hearthstone.",
            "characterImageKey": "happy"
          }
        ],
        "options": [
          {
            "id": "hub_ask_knowledge",
            "label": "What does The Knowledge mean?",
            "responseLines": [
              {
                "text": "The warmth leaves Bridget's face for a moment.",
                "characterImageKey": "sad"
              },
              {
                "speaker": "Bridget",
                "text": "'It means you know what helps, and what harms. Healing is part of it, but restraint is the greater part.'",
                "characterImageKey": "sad"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "hub_goodbye",
            "label": "I'll remember that.",
            "responseLines": [
              {
                "text": "Bridget's smile returns.",
                "characterImageKey": "happy"
              },
              {
                "speaker": "Bridget",
                "text": "'Good. Then the village and yourself are off to a fair start.'",
                "characterImageKey": "happy"
              }
            ],
            "endsInteraction": true,
            "effects": [
              {
                "addStoryFlag": "bridget_welcomed_player"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "plot_line_demo_visit_1",
    "title": "Mrs Vale",
    "text": "Mrs Vale needs a draught that steadies her nerves and keeps her thoughts clear, with no sleepy or mournful edge.",
    "lines": [
      {
        "text": "A woman in a rain-dark cloak waits until the shop is quiet."
      },
      {
        "speaker": "Mrs Vale",
        "text": "'I need my hands still and my mind sharper than fear.'"
      }
    ],
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "plot",
    "difficulty": 2,
    "storyCharacterId": "mrs_vale",
    "visitId": "visit_1",
    "dialogueStartNodeId": "intro",
    "requires": {
      "dayMin": 1
    },
    "weight": 1,
    "desiredTraits": {
      "soothe": { "min": 3, "max": 6 },
      "clarity": { "min": 3, "max": 6 },
      "courage": { "min": 2, "max": 5 }
    },
    "badTraits": {
      "drowsiness": { "max": 0 },
      "melancholy": { "max": 1 }
    },
    "potionRefusedLines": [
      {
        "text": "Mrs Vale tucks her gloves back into her sleeve."
      },
      {
        "speaker": "Mrs Vale",
        "text": "'Then I will try to keep steady without it.'"
      }
    ],
    "onPotionRefusedEffects": [
      {
        "addStoryFlag": "mrs_vale_refused_potion"
      }
    ],
    "onSuccessEffects": [
      {
        "addStoryFlag": "mrs_vale_helped"
      }
    ],
    "onFailureEffects": [
      {
        "addStoryFlag": "mrs_vale_given_bad_potion"
      }
    ],
    "potionResponses": [
      {
        "id": "clean_success",
        "success": true,
        "minMatchedDesiredTraits": 2,
        "maxMatchedBadTraits": 0,
        "lines": [
          {
            "text": "Mrs Vale tests the cork with one thumb, then lets out a slow breath."
          },
          {
            "speaker": "Mrs Vale",
            "text": "'Yes. Steady enough for the hand, clear enough for the work.'"
          }
        ]
      },
      {
        "id": "clouded_failure",
        "success": false,
        "lines": [
          {
            "text": "The mixture clouds against the glass."
          },
          {
            "speaker": "Mrs Vale",
            "text": "'No. This would make the room tilt, and I need it still.'"
          }
        ]
      }
    ],
    "dialogueNodes": [
      {
        "id": "intro",
        "lines": [
          {
            "text": "Rain ticks against the counter glass as Mrs Vale removes a folded note."
          },
          {
            "speaker": "Mrs Vale",
            "text": "'I was told you can quiet a person without dulling them.'"
          }
        ],
        "options": [
          {
            "id": "intro_work",
            "label": "What work requires that?",
            "responseLines": [
              {
                "text": "She looks toward the shop window before answering."
              },
              {
                "speaker": "Mrs Vale",
                "text": "'Copying a will before dawn. One wrong word and a dead man's house goes to war.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_fear",
            "label": "What are you afraid of?",
            "responseLines": [
              {
                "text": "The note trembles once in her hand."
              },
              {
                "speaker": "Mrs Vale",
                "text": "'That I will see the wrong name and write it anyway.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_request",
            "label": "What should the potion do?",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'Soothe the hand, clear the eye, and lend me courage if the brew can bear it. No drowsiness; barely any melancholy.'"
              }
            ],
            "revealsRequest": true,
            "returnNodeId": "hub"
          },
          {
            "id": "intro_end",
            "label": "I cannot help tonight.",
            "responseLines": [
              {
                "text": "Mrs Vale folds the note along its old crease."
              },
              {
                "speaker": "Mrs Vale",
                "text": "'Then I will find a steadier hand elsewhere.'"
              }
            ],
            "endsInteraction": true,
            "effects": [
              {
                "addStoryFlag": "mrs_vale_dismissed"
              }
            ]
          }
        ]
      },
      {
        "id": "hub",
        "lines": [
          {
            "text": "Mrs Vale keeps the folded note pressed flat beneath her palm."
          }
        ],
        "options": [
          {
            "id": "hub_note",
            "label": "Tell me about the note.",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'It names people who have waited years to hate each other properly.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "hub_request",
            "label": "Repeat the potion request.",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'Soothe, clarity, courage if possible. No drowsiness, and only the faintest melancholy.'"
              }
            ],
            "revealsRequest": true,
            "returnNodeId": "hub"
          },
          {
            "id": "hub_leave",
            "label": "That is enough.",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'Then let us not waste the hour.'"
              }
            ],
            "endsInteraction": true
          }
        ]
      }
    ]
  },
  {

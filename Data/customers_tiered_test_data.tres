[gd_resource type="Resource" script_class="AuthoredCustomerInteractionsResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Models/AuthoredCustomerInteractionsResource.cs" id="1"]

[resource]
script = ExtResource("1")
Entries = [
  {
    "id": "plot_bridget_visit_1",
    "title": "Bridget",
    "text": "Bridget needs a potion that steadies her nerves and keeps her thoughts clear without sleepiness or taint.",
    "lines": [
      {
        "text": "Bridget steps into the shop with a notebook pressed to her chest."
      },
      {
        "speaker": "Bridget",
        "text": "'My nerves are running ahead of me, and I need them brought to heel.'"
      }
    ],
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "plot",
    "difficulty": 2,
    "storyCharacterId": "bridget",
    "visitId": "visit_1",
    "dialogueStartNodeId": "intro",
    "requires": {
      "dayMin": 1
    },
    "weight": 2,
    "desiredTraits": {
      "calm": { "min": 3, "max": 6 },
      "clarity": { "min": 3, "max": 6 },
      "cleanse": { "min": 2, "max": 5 }
    },
    "badTraits": {
      "drowsiness": { "max": 0 },
      "corruption": { "max": 0 }
    },
    "potionRefusedLines": [
      {
        "text": "Bridget closes her notebook with careful fingers."
      },
      {
        "speaker": "Bridget",
        "text": "'That's okay, dear. I knew it was a big ask.'"
      }
    ],
    "onPotionRefusedEffects": [
      {
        "addStoryFlag": "bridget_refused_potion"
      }
    ],
    "onSuccessEffects": [
      {
        "addStoryFlag": "bridget_helped"
      }
    ],
    "onFailureEffects": [
      {
        "addStoryFlag": "bridget_given_bad_potion"
      }
    ],
    "potionResponses": [
      {
        "id": "clean_success",
        "success": true,
        "minMatchedDesiredTraits": 2,
        "maxMatchedBadTraits": 0,
        "lines": [
          {
            "text": "Bridget holds the bottle against the lamplight and watches the liquid settle clear."
          },
          {
            "speaker": "Bridget",
            "text": "'Yes. Quiet enough for my hands, sharp enough for the page.'"
          }
        ]
      },
      {
        "id": "risky_failure",
        "success": false,
        "lines": [
          {
            "text": "The mixture clings to the glass in slow, cloudy threads."
          },
          {
            "speaker": "Bridget",
            "text": "'No. This would slow me down or muddle the words. I cannot risk that.'"
          }
        ]
      }
    ],
    "dialogueNodes": [
      {
        "id": "intro",
        "lines": [
          {
            "text": "Bridget lays the notebook on the counter, then keeps one hand over its cover."
          },
          {
            "speaker": "Bridget",
            "text": "'I was told you can settle a person without sending them to sleep.'"
          }
        ],
        "options": [
          {
            "id": "intro_who_are_you",
            "label": "Who are you?",
            "responseLines": [
              {
                "text": "She straightens as if the question has weight."
              },
              {
                "speaker": "Bridget",
                "text": "'Bridget. I copy ledgers for people who dislike mistakes more than they dislike cruelty.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_private_trouble",
            "label": "What private trouble?",
            "responseLines": [
              {
                "text": "Her thumb traces the corner of the notebook."
              },
              {
                "speaker": "Bridget",
                "text": "'Numbers move when I look at them too long. Or I think they do, which is worse.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_request",
            "label": "What potion do you need?",
            "responseLines": [
              {
                "speaker": "Bridget",
                "text": "'Calm and clarity, with enough cleansing to keep the work clean. No drowsiness, and nothing corrupting.'"
              }
            ],
            "revealsRequest": true,
            "returnNodeId": "hub"
          },
          {
            "id": "intro_end",
            "label": "Not tonight.",
            "responseLines": [
              {
                "text": "Bridget gathers the notebook back to her chest."
              },
              {
                "speaker": "Bridget",
                "text": "'Then I will try to keep my hand steady on my own.'"
              }
            ],
            "endsInteraction": true,
            "effects": [
              {
                "addStoryFlag": "bridget_dismissed"
              }
            ]
          }
        ]
      },
      {
        "id": "hub",
        "lines": [
          {
            "text": "Bridget opens the notebook only far enough to show columns of cramped figures."
          }
        ],
        "options": [
          {
            "id": "hub_house",
            "label": "Tell me about the office.",
            "responseLines": [
              {
                "speaker": "Bridget",
                "text": "'It is not a house, exactly. It is an office with too many locked drawers and not enough honest men.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "hub_request",
            "label": "Tell me the potion again.",
            "responseLines": [
              {
                "speaker": "Bridget",
                "text": "'Calm, clarity, and a clean edge if you can manage it. Drowsiness and corruption would ruin everything.'"
              }
            ],
            "revealsRequest": true,
            "returnNodeId": "hub"
          },
          {
            "id": "hub_leave",
            "label": "That is all for now.",
            "responseLines": [
              {
                "speaker": "Bridget",
                "text": "'Then I will leave before I lose my nerve.'"
              }
            ],
            "endsInteraction": true
          }
        ]
      }
    ]
  },
  {
    "id": "plot_line_demo_visit_1",
    "title": "Mrs Vale",
    "text": "Mrs Vale needs a draught that steadies her nerves and keeps her thoughts clear, with no sleepy or mournful edge.",
    "lines": [
      {
        "text": "A woman in a rain-dark cloak waits until the shop is quiet."
      },
      {
        "speaker": "Mrs Vale",
        "text": "'I need my hands still and my mind sharper than fear.'"
      }
    ],
    "characterImagePath": "res://art/Middleclass-Woman.png",
    "pool": "plot",
    "difficulty": 2,
    "storyCharacterId": "mrs_vale",
    "visitId": "visit_1",
    "dialogueStartNodeId": "intro",
    "requires": {
      "dayMin": 1
    },
    "weight": 1,
    "desiredTraits": {
      "soothe": { "min": 3, "max": 6 },
      "clarity": { "min": 3, "max": 6 },
      "courage": { "min": 2, "max": 5 }
    },
    "badTraits": {
      "drowsiness": { "max": 0 },
      "melancholy": { "max": 1 }
    },
    "potionRefusedLines": [
      {
        "text": "Mrs Vale tucks her gloves back into her sleeve."
      },
      {
        "speaker": "Mrs Vale",
        "text": "'Then I will try to keep steady without it.'"
      }
    ],
    "onPotionRefusedEffects": [
      {
        "addStoryFlag": "mrs_vale_refused_potion"
      }
    ],
    "onSuccessEffects": [
      {
        "addStoryFlag": "mrs_vale_helped"
      }
    ],
    "onFailureEffects": [
      {
        "addStoryFlag": "mrs_vale_given_bad_potion"
      }
    ],
    "potionResponses": [
      {
        "id": "clean_success",
        "success": true,
        "minMatchedDesiredTraits": 2,
        "maxMatchedBadTraits": 0,
        "lines": [
          {
            "text": "Mrs Vale tests the cork with one thumb, then lets out a slow breath."
          },
          {
            "speaker": "Mrs Vale",
            "text": "'Yes. Steady enough for the hand, clear enough for the work.'"
          }
        ]
      },
      {
        "id": "clouded_failure",
        "success": false,
        "lines": [
          {
            "text": "The mixture clouds against the glass."
          },
          {
            "speaker": "Mrs Vale",
            "text": "'No. This would make the room tilt, and I need it still.'"
          }
        ]
      }
    ],
    "dialogueNodes": [
      {
        "id": "intro",
        "lines": [
          {
            "text": "Rain ticks against the counter glass as Mrs Vale removes a folded note."
          },
          {
            "speaker": "Mrs Vale",
            "text": "'I was told you can quiet a person without dulling them.'"
          }
        ],
        "options": [
          {
            "id": "intro_work",
            "label": "What work requires that?",
            "responseLines": [
              {
                "text": "She looks toward the shop window before answering."
              },
              {
                "speaker": "Mrs Vale",
                "text": "'Copying a will before dawn. One wrong word and a dead man's house goes to war.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_fear",
            "label": "What are you afraid of?",
            "responseLines": [
              {
                "text": "The note trembles once in her hand."
              },
              {
                "speaker": "Mrs Vale",
                "text": "'That I will see the wrong name and write it anyway.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "intro_request",
            "label": "What should the potion do?",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'Soothe the hand, clear the eye, and lend me courage if the brew can bear it. No drowsiness; barely any melancholy.'"
              }
            ],
            "revealsRequest": true,
            "returnNodeId": "hub"
          },
          {
            "id": "intro_end",
            "label": "I cannot help tonight.",
            "responseLines": [
              {
                "text": "Mrs Vale folds the note along its old crease."
              },
              {
                "speaker": "Mrs Vale",
                "text": "'Then I will find a steadier hand elsewhere.'"
              }
            ],
            "endsInteraction": true,
            "effects": [
              {
                "addStoryFlag": "mrs_vale_dismissed"
              }
            ]
          }
        ]
      },
      {
        "id": "hub",
        "lines": [
          {
            "text": "Mrs Vale keeps the folded note pressed flat beneath her palm."
          }
        ],
        "options": [
          {
            "id": "hub_note",
            "label": "Tell me about the note.",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'It names people who have waited years to hate each other properly.'"
              }
            ],
            "nextNodeId": "hub"
          },
          {
            "id": "hub_request",
            "label": "Repeat the potion request.",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'Soothe, clarity, courage if possible. No drowsiness, and only the faintest melancholy.'"
              }
            ],
            "revealsRequest": true,
            "returnNodeId": "hub"
          },
          {
            "id": "hub_leave",
            "label": "That is enough.",
            "responseLines": [
              {
                "speaker": "Mrs Vale",
                "text": "'Then let us not waste the hour.'"
              }
            ],
            "endsInteraction": true
          }
        ]
      }
    ]
  },

[resource]
script = ExtResource("1")
Entries = [{
"badTraits": {},
"characterImagePath": "res://Assets/Characters/old_rural_woman_sprite_happy.png",
"characterImagePaths": {
"happy": "res://Assets/Characters/old_rural_woman_sprite_happy.png",
"sad": "res://Assets/Characters/old_rural_woman_sprite_sad.png"
},
"desiredTraits": {},
"dialogueNodes": [{
"id": "intro",
"lines": [{
"characterImageKey": "happy",
"text": "She smiles as though she has known your family name longer than you have."
}, {
"characterImageKey": "happy",
"speaker": "Bridget",
"text": "'Bridget, that's me. If you need bread, gossip, or the name of a good thatcher, you come and find me.'"
}, {
"characterImageKey": "sad",
"text": "Her smile softens, and her eyes settle on your hands."
}, {
"characterImageKey": "sad",
"speaker": "Bridget",
"text": "'And I know you have {i|The Knowledge}. In Ireland, that's what some call knowing the old properties of things: brewing, healing, and the uses hidden in leaf and root.'"
}],
"options": [{
"id": "intro_ask_knowledge",
"label": "How did you know?",
"nextNodeId": "hub",
"responseLines": [{
"characterImageKey": "happy",
"text": "Bridget gives a small, knowing shrug."
}, {
"characterImageKey": "happy",
"speaker": "Bridget",
"text": "'You look at herbs the way a mason looks at stone. A body learns to notice.'"
}]
}, {
"id": "intro_ask_village",
"label": "Tell me about the village.",
"nextNodeId": "hub",
"responseLines": [{
"characterImageKey": "happy",
"text": "She glances back toward the rain-slick lane."
}, {
"characterImageKey": "happy",
"speaker": "Bridget",
"text": "'Small enough to hear every kettle boil, large enough to keep secrets badly. You'll do fine if you listen before you answer.'"
}]
}, {
"effects": [{
"addStoryFlag": "bridget_welcomed_player"
}],
"endsInteraction": true,
"id": "intro_accept",
"label": "Thank you, Bridget.",
"responseLines": [{
"characterImageKey": "happy",
"text": "Bridget pats your arm once, gentle but firm."
}, {
"characterImageKey": "happy",
"speaker": "Bridget",
"text": "'There's a welcome here for you. Mind you use that Knowledge kindly.'"
}]
}, {
"endsInteraction": true,
"id": "intro_attack",
"label": "Attack",
"responseLines": []
}]
}, {
"id": "hub",
"lines": [{
"characterImageKey": "happy",
"text": "Bridget waits, patient as a hearthstone."
}],
"options": [{
"id": "hub_ask_knowledge",
"label": "What does The Knowledge mean?",
"nextNodeId": "hub",
"responseLines": [{
"characterImageKey": "sad",
"text": "The warmth leaves Bridget's face for a moment."
}, {
"characterImageKey": "sad",
"speaker": "Bridget",
"text": "'It means you know what helps, and what harms. Healing is part of it, but restraint is the greater part.'"
}]
}, {
"effects": [{
"addStoryFlag": "bridget_welcomed_player"
}],
"endsInteraction": true,
"id": "hub_goodbye",
"label": "I'll remember that.",
"responseLines": [{
"characterImageKey": "happy",
"text": "Bridget's smile returns."
}, {
"characterImageKey": "happy",
"speaker": "Bridget",
"text": "'Good. Then the village and yourself are off to a fair start.'"
}]
}]
}],
"dialogueStartNodeId": "intro",
"difficulty": 1,
"id": "plot_bridget_visit_1",
"lines": [{
"characterImageKey": "happy",
"text": "An old woman waits near the door, shawl pinned tight against the damp air."
}, {
"characterImageKey": "happy",
"speaker": "Bridget",
"text": "'You're the new one, then. Welcome to the village, my dear.'"
}],
"pool": "plot",
"requires": {
"dayMin": 1,
"hasStoryFlag": "bridget_welcome_pending"
},
"storyCharacterId": "bridget",
"text": "Bridget welcomes you to the village and recognizes that you carry The Knowledge.",
"title": "Bridget",
"visitId": "visit_1",
"weight": 2
}, {

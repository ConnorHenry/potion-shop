theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="EventModal/Panel/Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="EventModal/Panel/Margin/VBox"]
layout_mode = 2
text = "Night Event"

[node name="Portrait" type="TextureRect" parent="EventModal/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Body" type="RichTextLabel" parent="EventModal/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
text = "..."
fit_content = true

[node name="Choices" type="VBoxContainer" parent="EventModal/Panel/Margin/VBox"]
layout_mode = 2
